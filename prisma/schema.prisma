generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  FABRIC
  READY_MADE
}

model Category {
  id                String             @id @default(cuid())
  name              String             @unique // e.g. "Unstitched Fabric", "Ready to Wear", "Pret Collection"
  slug              String             @unique
  createdAt         DateTime           @default(now())
  readyMadeProducts ReadyMadeProduct[]
}

model Fabric {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float // Price per meter
  stock       Int // Stock in meters
  material    String?
  width       String? // e.g. "58 inches"
  weight      String? // e.g. "120 GSM"
  images      String[]
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReadyMadeProduct {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  price       Float // Price per piece
  stock       Int // Stock in pieces/units
  sizes       String[] // e.g. ["S", "M", "L", "XL"]
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  images      String[]
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  ONLINE_PAYMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerEmail String
  phone         String
  address       String
  city          String
  postalCode    String?
  paymentMethod PaymentMethod @default(COD)
  paymentStatus String        @default("Pending")
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  items         OrderItem[]
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity Int
  price    Float
}
