generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  FABRIC
  READY_MADE
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "Unstitched Fabric", "Ready to Wear", "Pret Collection"
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Float
  type        ProductType @default(FABRIC)
  images      String[]
  material    String?
  weight      String?
  width       String?
  sizes       String[]
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  ONLINE_PAYMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerEmail String
  phone         String
  address       String
  city          String
  postalCode    String?
  paymentMethod PaymentMethod @default(COD)
  paymentStatus String        @default("Pending")
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  items         OrderItem[]
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
